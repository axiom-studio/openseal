# Binaries
openseal
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/
skills/repos/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
bin/
dist/

# Local config
daemon.yaml
context.yaml
workflow.hcl
bad_workflow.hcl

# ...but the container's own config must reach the build context: the Dockerfile
# copies it to /app/daemon.yaml, which is the path CMD names. The `daemon.yaml`
# pattern above is anchored to the context root and so does not match this
# nested path, but state it explicitly rather than depend on that subtlety — if
# the exclusion ever did apply, the COPY would fail the build.
!docker/daemon.yaml

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
*.md
LICENSE

# ...but the licence itself must ship inside the image. Apache-2.0 section 4(a)
# requires giving recipients of the Work a copy of the License, and pushing to a
# registry distributes it to anyone who pulls. The release tarballs already
# include LICENSE, so shipping it here also stops the two distribution channels
# disagreeing.
#
# This exception must stay BELOW the `LICENSE` line above: .dockerignore
# resolves by last match, so re-including it first would be silently undone.
!LICENSE
